class Solution {

    String s;
    Long[][][][][] cntMemo;
    Long[][][][][] sumMemo;

    public long totalWaviness(long num1, long num2) {
        return solve(num2) - solve(num1 - 1);
    }

    private long solve(long x) {
        if (x <= 0) return 0;

        s = String.valueOf(x);
        int n = s.length();

        cntMemo = new Long[n + 1][11][11][2][2];
        sumMemo = new Long[n + 1][11][11][2][2];

        return dfs(0, 10, 10, 1, 0)[1];
    }

    // returns {countNumbers, totalWaviness}
    private long[] dfs(int pos, int prev2, int prev1,
                       int tight, int started) {

        if (pos == s.length()) {
            return new long[]{started == 1 ? 1 : 0, 0};
        }

        if (cntMemo[pos][prev2][prev1][tight][started] != null) {
            return new long[]{
                cntMemo[pos][prev2][prev1][tight][started],
                sumMemo[pos][prev2][prev1][tight][started]
            };
        }

        long totalCnt = 0;
        long totalWave = 0;

        int limit = tight == 1 ? s.charAt(pos) - '0' : 9;

        for (int d = 0; d <= limit; d++) {

            int ntight = (tight == 1 && d == limit) ? 1 : 0;

            if (started == 0 && d == 0) {

                long[] nxt = dfs(pos + 1, 10, 10, ntight, 0);

                totalCnt += nxt[0];
                totalWave += nxt[1];

            } else {

                long add = 0;

                if (started == 1 && prev2 != 10) {

                    if ((prev1 > prev2 && prev1 > d) ||
                        (prev1 < prev2 && prev1 < d)) {
                        add = 1;
                    }
                }

                int nprev2 = started == 0 ? 10 : prev1;
                int nprev1 = d;

                long[] nxt =
                    dfs(pos + 1, nprev2, nprev1,
                        ntight, 1);

                totalCnt += nxt[0];

                totalWave += nxt[1] + add * nxt[0];
            }
        }

        cntMemo[pos][prev2][prev1][tight][started] = totalCnt;
        sumMemo[pos][prev2][prev1][tight][started] = totalWave;

        return new long[]{totalCnt, totalWave};
    }
}
